# ==============================================================================
# IPOVision Environment Variables
# Copy this file to '.env' and fill in your values. Never commit '.env' to git!
# ==============================================================================

# Google Gemini API key (Required for RHP/DRHP RAG Intelligence Engine)
# Obtain a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Project Root & Path Overrides (Optional - defaults to relative project paths)
# IPOVISION_DATA_DIR=./data
# IPOVISION_MODELS_DIR=./models
# IPOVISION_CHROMA_DIR=./chroma_db

