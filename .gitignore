# Vector Store and RAG artifacts
chroma_db/
*.chroma
vector_store/
temp_uploads/
*.pdf

# Model binary weights (allow directory structure via .gitkeep)
models/*.joblib
models/*.pkl
models/*.onnx
models/*.bin
!models/.gitkeep

# Large Data files (Keep schemas & gitkeeps, ignore raw scraped files)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.sample.csv
!data/processed/data_dictionary.md

# Reports generated figures
reports/figures/*
!reports/figures/.gitkeep
reports/evaluation/*
!reports/evaluation/.gitkeep

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

